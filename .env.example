# URL del backend Express, SIN barra al final.
#   · En desarrollo, el servidor corre en el 4000.
#   · En Vercel (Project → Settings → Environment Variables) pon la URL
#     de Render, ej. https://english-lessons-api.onrender.com
# Vite incrusta este valor AL COMPILAR: si lo cambias en Vercel, haz
# Redeploy. Todo lo que empieza con VITE_ es público (lo ve el navegador):
# nunca pongas claves secretas aquí.
VITE_API_URL=http://localhost:4000

# Captcha "No soy un robot" (Cloudflare Turnstile) en el login y al
# activar cuentas. Es la clave de SITIO (pública). Va en pareja con
# TURNSTILE_SECRET_KEY del servidor. Vacío = sin captcha (desarrollo).
# Clave de prueba de Cloudflare (siempre aprueba): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
